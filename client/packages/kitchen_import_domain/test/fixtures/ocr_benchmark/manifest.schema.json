{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kitchen OCR quality benchmark manifest",
  "type": "object",
  "required": ["schemaVersion", "sampleSetVersion", "license", "samples"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sampleSetVersion": {"type": "string"},
    "license": {"type": "string"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "imagePath", "sourceKind", "traits", "scriptProfile", "groundTruth"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "imagePath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "sourceKind": {"enum": ["synthetic", "selfAuthored", "authorized", "privateLocal"]},
          "traits": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "scriptProfile": {"enum": ["hans", "hant", "mixed"]},
          "groundTruth": {
            "type": "object",
            "required": ["text", "effectiveLines", "noiseLines", "title", "ingredients", "steps"],
            "properties": {
              "text": {"type": "string"},
              "effectiveLines": {"type": "array", "items": {"type": "string"}},
              "noiseLines": {"type": "array", "items": {"type": "string"}},
              "title": {"type": "string"},
              "ingredients": {"type": "array", "items": {"type": "string"}},
              "steps": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
