APP_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgresql://kitchen:kitchen-local-only@127.0.0.1:5432/kitchen_development
AUTH_SIGNING_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PHONE_OTP_PEPPER=replace-with-a-long-random-phone-otp-pepper
# 本地模拟手机号登录：仍执行完整预检和 OTP 校验，但不会调用短信供应商。
PHONE_AUTH_MODE=mock
PHONE_MOCK_OTP=111111
PHONE_MOCK_CAPTCHA_TOKEN=local-captcha-ok
PHONE_DAILY_SEND_LIMIT=100
PHONE_DAILY_BUDGET_UNITS=100
# Apple 登录配置只注入 App ID / Services ID；私钥和 client secret 由秘密管理设施提供。
APPLE_CLIENT_ID=
APPLE_ISSUER=https://appleid.apple.com
